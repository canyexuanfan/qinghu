<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- QH-P16（用户授权 2026-09-18）：仅供用户显式开启的规则更新通道使用；默认无任何网络请求 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- QH-P17 存活加固：无障碍引擎随服务进程常驻（specialUse 前台服务），防激进 ROM 杀后台 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 设置页"防杀后台"引导：申请电池优化白名单（用户显式点击才发起） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Only launchable applications are queried. No QUERY_ALL_PACKAGES or INTERNET permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- QH-P05-07：检测 Shizuku 管理器是否安装（Android 11+ 包可见性最小查询） -->
        <package android:name="moe.shizuku.manager" />
        <package android:name="moe.shizuku.privileged.api" />
    </queries>
    <application
        android:name=".GuardApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Guard"
        android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- QH-P05-02：无障碍服务。系统持有 BIND_ACCESSIBILITY_SERVICE 权限；应用不声明任何危险权限。 -->
        <!-- QH-P17：specialUse 前台服务常驻通知，降低激进 ROM 杀进程导致无障碍"自己关掉"的概率 -->
        <service
            android:name=".platform.accessibility.GuardAccessibilityService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/guard_accessibility" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled accessibility ad-skip engine keepalive; service is system-bound and must stay alive to keep protection active" />
        </service>
    </application>
</manifest>
