<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Guard" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:colorAccent">@color/green</item>
        <item name="colorAccent">@color/green</item>
        <item name="colorControlActivated">@color/green</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="Text.Base" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Text.Title" parent="Text.Base">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Section" parent="Text.Base">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Body" parent="Text.Base">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Sub" parent="Text.Base">
        <item name="android:textColor">@color/sub</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="Text.Pill" parent="Text.Base">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/green_dark</item>
        <item name="android:background">@drawable/bg_mint</item>
        <item name="android:paddingHorizontal">9dp</item>
        <item name="android:paddingVertical">5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="IconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/ink</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">14dp</item>
    </style>
    <style name="Guard.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="track">@drawable/switch_track</item>
        <item name="switchMinWidth">46dp</item>
        <item name="switchPadding">0dp</item>
        <item name="thumbTextPadding">0dp</item>
        <item name="showText">false</item>
        <item name="splitTrack">false</item>
    </style>
</resources>
