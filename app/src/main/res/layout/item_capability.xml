<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/capability_row_height" android:padding="12dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_ripple_card" android:clickable="true" android:focusable="true">
    <ImageView android:id="@+id/icon" android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/cap_cleaner" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/title" style="@style/Text.Body" android:text="广告净化"/>
        <TextView android:id="@+id/description" style="@style/Text.Sub" android:text="自动关闭 / 跳过 可安全识别的广告" android:layout_marginTop="5dp"/>
    </LinearLayout>
    <TextView android:id="@+id/status" style="@style/Text.Pill" android:text="待接入" android:layout_marginStart="5dp"/>
    <ImageView android:layout_width="16dp" android:layout_height="18dp" android:src="@drawable/ic_chevron" android:layout_marginStart="2dp" android:importantForAccessibility="no"/>
</LinearLayout>
