<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="82dp" android:padding="12dp" android:layout_marginBottom="8dp" android:orientation="horizontal" android:background="@drawable/bg_ripple_card" android:clickable="true" android:focusable="true">
