<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="104dp" android:padding="18dp" android:orientation="vertical" android:background="@drawable/bg_ripple_card" android:clickable="true" android:focusable="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/title" style="@style/Text.Section" android:layout_width="0dp" android:layout_weight="1" android:text="保护强度"/>
        <TextView android:id="@+id/value" style="@style/Text.Body" android:text="智能保护" android:textColor="@color/green"/>
        <ImageView android:layout_width="17dp" android:layout_height="20dp" android:layout_marginStart="10dp" android:src="@drawable/ic_chevron" android:importantForAccessibility="no"/>
    </LinearLayout>
    <TextView android:id="@+id/subtitle" style="@style/Text.Sub" android:text="根据应用特点自动调整各项保护策略" android:layout_marginTop="14dp"/>
</LinearLayout>
