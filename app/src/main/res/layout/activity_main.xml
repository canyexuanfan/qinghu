<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/page">
    <androidx.fragment.app.FragmentContainerView android:id="@+id/content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" tools:layout="@layout/fragment_home"/>
    <LinearLayout android:id="@+id/bottomNav" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/bg_nav" android:elevation="2dp">
        <LinearLayout android:id="@+id/navHome" android:layout_width="0dp" android:layout_weight="1" android:layout_height="@dimen/nav_height" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:contentDescription="首页">
            <ImageView android:id="@+id/navIconHome" android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/nav_home" app:tint="@color/nav_tint" android:duplicateParentState="true" android:importantForAccessibility="no"/>
            <TextView style="@style/Text.Base" android:text="首页" android:textSize="12sp" android:textColor="@color/nav_tint" android:layout_marginTop="4dp" android:duplicateParentState="true"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navApps" android:layout_width="0dp" android:layout_weight="1" android:layout_height="@dimen/nav_height" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:contentDescription="应用">
            <ImageView android:id="@+id/navIconApps" android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/nav_apps" app:tint="@color/nav_tint" android:duplicateParentState="true" android:importantForAccessibility="no"/>
            <TextView style="@style/Text.Base" android:text="应用" android:textSize="12sp" android:textColor="@color/nav_tint" android:layout_marginTop="4dp" android:duplicateParentState="true"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navRecords" android:layout_width="0dp" android:layout_weight="1" android:layout_height="@dimen/nav_height" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:contentDescription="记录">
            <ImageView android:id="@+id/navIconRecords" android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/nav_records" app:tint="@color/nav_tint" android:duplicateParentState="true" android:importantForAccessibility="no"/>
            <TextView style="@style/Text.Base" android:text="记录" android:textSize="12sp" android:textColor="@color/nav_tint" android:layout_marginTop="4dp" android:duplicateParentState="true"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navSubs" android:layout_width="0dp" android:layout_weight="1" android:layout_height="@dimen/nav_height" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:contentDescription="订阅">
            <ImageView android:id="@+id/navIconSubs" android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_globe" app:tint="@color/nav_tint" android:duplicateParentState="true" android:importantForAccessibility="no"/>
