        </LinearLayout>
        <LinearLayout android:id="@+id/navSettings" android:layout_width="0dp" android:layout_weight="1" android:layout_height="@dimen/nav_height" android:gravity="center" android:orientation="vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:contentDescription="我的">
            <ImageView android:id="@+id/navIconSettings" android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/nav_person" app:tint="@color/nav_tint" android:duplicateParentState="true" android:importantForAccessibility="no"/>
            <TextView style="@style/Text.Base" android:text="我的" android:textSize="12sp" android:textColor="@color/nav_tint" android:layout_marginTop="4dp" android:duplicateParentState="true"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
