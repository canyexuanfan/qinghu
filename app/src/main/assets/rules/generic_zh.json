  "rules": [
    {
      "id": "generic.splash.skip",
      "version": 5,
      "provenance": {
        "author": "Qinghu",
        "license": "PROJECT-OWNED",
        "source": "self-authored-generic"
      },
      "target": {
        "package": "*",
        "minVersionCode": 0,
        "maxVersionCode": 999999
      },
      "page": {
        "mustNotHave": [
          "sensitive_payment",
          "password",
          "confirm_pay"
        ]
      },
      "match": {
        "textEquals": "跳过",
        "windowTextContainsAny": [
          "广告"
        ],
        "ancestorViewIdContainsAny": [
          "ad_",
          "_ad",
          "adview",
          "advert",
          "splashad",
          "ksad",
          "gdtad",
          "sigmob",
          "mbridge",
          "mobads"
        ]
      },
      "action": {
        "type": "CLICK_VERIFIED_NODE",
        "maxAttempts": 2,
        "cooldownMs": 2000
      }
    },
